---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Facts from "../../components/Facts.astro";
import { url } from "../../url";
import { works, years, type Work } from "../../works";

export async function getStaticPaths() {
  const all = await works();
  return all.map((work, i) => ({ params: { id: work.id }, props: { work, prev: all[i - 1], next: all[i + 1] } }));
}

const { work, prev, next } = Astro.props as { work: Work; prev?: Work; next?: Work };
const { Content } = await render(work);
const d = work.data;
const rows: [string, string | typeof d.links][] = [
  ["Years", years(work)],
  ...(d.role ? [["Role", d.role] as [string, string]] : []),
  ...(d.with ? [["With", d.with] as [string, string]] : []),
  ...(d.links.length ? [["Links", d.links] as [string, typeof d.links]] : []),
];
const src = (file: string) => url(`images/${file}`).replace(/\/$/, "");
---
<Base title={d.title} description={d.summary}>
  <span class="label"><a class="crumb" href={url("works/")}>Works</a> · {years(work)}</span>
  <h1>{d.title}</h1>
  <p class="lead">{d.summary}</p>

  <Facts rows={rows} />

  {work.body?.trim() && <div class="prose body"><Content /></div>}

  {d.video && <iframe class="video" src={d.video} title={d.title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>}

  {d.images.length > 0 && (
    <div class:list={["gallery", { single: d.images.length === 1 }]}>
      {d.images.map((i) => (
        <figure>
          <a href={src(i.src)}><img src={src(i.src)} alt={i.alt} loading="lazy" /></a>
          {i.caption && <figcaption>{i.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}

  <div class="pager">
    {prev && <a href={url(`works/${prev.id}/`)}><span class="label"><span aria-hidden="true">←</span> Previous</span><b>{prev.data.title}</b></a>}
    {next && <a href={url(`works/${next.id}/`)}><span class="label">Next <span aria-hidden="true">→</span></span><b>{next.data.title}</b></a>}
  </div>
</Base>
