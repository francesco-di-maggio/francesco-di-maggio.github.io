---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const SECTIONS = {
  work: "Work",
  teaching: "Teaching",
  education: "Education",
  performances: "Performances",
  presentations: "Presentations",
} as const;

// Newest first: `when` starts with the year, so text order is date order.
const entries = (await getCollection("cv")).sort((a, b) => b.data.when.localeCompare(a.data.when));
---
<Base title="CV" description="CV of Francesco Di Maggio.">
  <h1>CV</h1>
  <p class="lead">Work, teaching, education, performances and presentations.</p>
  {Object.entries(SECTIONS).map(([key, title]) => (
    <Fragment>
      <h2 class="label">{title}</h2>
      <div class="panel lists">
        <ul class="list">
          {entries.filter((e) => e.data.section === key).map((e) => {
            const text = <span class="text"><b>{e.data.title}</b>{e.data.sub && <span class="sub">{e.data.sub}</span>}</span>;
            const when = <span class="label">{e.data.when}</span>;
            return <li id={e.id}>{e.data.url ? <a class="row" href={e.data.url}>{text}{when}</a> : <div class="row">{text}{when}</div>}</li>;
          })}
        </ul>
      </div>
    </Fragment>
  ))}
</Base>
